# Strawberry Server API
VITE_API_BASE_URL=http://localhost:10000/api/v1

# HTTP Basic credentials identifying the storefront. Anything in VITE_* is
# bundled into the client, so this is NOT a secret. Cart access is protected
# by the per-cart token the server issues. The key alone identifies the tenant
# (specs/004-multi-tenant-supabase research.md #9) — generate one with
# `npm run make-api-key -- <tenant-id>` in strawberry-server.
VITE_API_USER=store
VITE_API_KEY=

# Stripe's *publishable* key (safe to bundle into the client — it's not a secret, unlike
# STRIPE_SECRET_KEY on the server). Used to mount Stripe's Embedded Checkout form on /cart.
# From the Stripe dashboard, same account as the server's STRIPE_SECRET_KEY — a test-mode
# (pk_test_...) key for local dev.
VITE_STRIPE_PUBLISHABLE_KEY=

# Supabase project — used client-side only for a Realtime subscription to the live store-status
# signal (src/plugins/serviceRealtime.ts); no Supabase Auth involved, this storefront has no
# user identity at all. Both of these are bundled into the client (anything in VITE_* is
# public); the anon key is meant to be public and relies on Supabase's own Row-Level Security,
# not secrecy. Same project as strawberry-admin/strawberry-server.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=
